programa{
    funcao inicio(){
        inteiro n, i
        logico primo
        n=0
        enquanto(n<100){
            n=n+1
            primo=verdadeiro
            para(inteiro r = 2; inteiro n){
                se(n%i==0){
                    primo=falso
                    n + 1
                    pare
                }senao{
                    escreva(n)
                    n + 1
                }   
                }
            }
    }
}