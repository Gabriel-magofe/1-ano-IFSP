programa
{
	
	funcao inicio()
	{
		inteiro a, m, d, dv
		escreva("anos de vida: ")
		leia(a)
		escreva("meses de vida: ")
		leia(m)
		escreva("dias de vida: ")
		leia(d)
		dv=a*365+m*30+d
		escreva("Você ja viveu ",dv , " dias")
	}
}
