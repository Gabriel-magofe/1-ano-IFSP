programa
{
	
	funcao inicio()
	{
		real  s, d, p, r

	escreva("digite o valor do total do seu salario: ")
	leia(s)
	escreva(" digite o valor do desconto: ")
	leia (d)
	p = s/100*d
	r = s-p
	escreva("Resultado: ",r)
	}
}
