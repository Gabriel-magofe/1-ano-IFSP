programa
{
	
	funcao inicio()
	{
		real k, l, m

		escreva ("Kilometros rodados: ")
		leia(k)
		escreva("Litros de combustivel gasto: ")
		leia(l)
		m=k/l
		escreva("kilometros por litro: ", m)
	}
}
