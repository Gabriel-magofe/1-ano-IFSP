programa
{
	
	funcao inicio()
	{
		real b, bs, t
		escreva("Tamanho do arquivo em mb: ")
		leia (b)
		escreva("mb por segundo: ")
		leia(bs)
		t=b/bs
		escreva("tempo para instalar: ",t)

	}
}
