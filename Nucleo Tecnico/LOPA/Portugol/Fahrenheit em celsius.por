programa
{
	
	funcao inicio()
	{
		inteiro c, f
		escreva("Temperatura em fahrenheit: ")
		leia (f)
		c = ((f - 32) * 5) / 9
		escreva("Temperatura convertida: ", c,"C°")
	}
}                           
