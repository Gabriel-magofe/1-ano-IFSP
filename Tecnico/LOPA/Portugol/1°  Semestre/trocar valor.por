programa
{
	
	funcao inicio()
	{
		inteiro A, B, C
		escreva("Valor de A: ")
		leia(A)
		escreva("Valor de B: ")
		leia(B)
		C= A
		A= B
		B= C
		escreva("\n\nValor de A: ", A,"\nValor de B: ", B)
		
	}
}
