programa
{
	
	funcao inicio()
	{
		inteiro n
		escreva("digite um valor qualquer: ")
		leia(n)
		se(n>0){
			se(n>10){
				escreva("O numero é positivo e maior que 10")
			}senao{
				escreva("O numero é positivo e menor que 10")
					}
		}senao{
			se (n<0){
				escreva("o numero é negativo")
			}senao{
				escreva("o numero é igual a 0")
				}
				
			}
	}
}
