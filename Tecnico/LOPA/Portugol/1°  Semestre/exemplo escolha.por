programa
{
	
	funcao inicio()
	{
		inteiro n

		escreva("Digite um valor qualquer: ")
		leia (n)

		escolha(n)
			caso 1: escreva("O valor é igual a 1")
			pare
			caso 2: escreva("O valor é igual a 2")
			pare
			caso 3: escreva("O valor é igual a 3")
			pare
			caso 4: escreva("O valor é igual a 4")
			pare
			caso contrario: escreva("Valor inválido")
	}
}
