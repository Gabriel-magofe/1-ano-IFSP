programa
{
	
	funcao inicio()
	{
		inteiro n
		escreva("digite um valor qualquer: ")
		leia(n)
		se(n!=100){
			se(n>100){
				escreva("O numero é maior que 100")
			}senao{
				escreva("O numero é menor que 100")
					}
		}senao{
			escreva("o numero é igual a 100")
		}
	}
}
