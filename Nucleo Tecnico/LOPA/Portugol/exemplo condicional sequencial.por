programa
{
	
	funcao inicio()
	{
		inteiro n1, n2, n3, n4, m

		escreva("digite o primeiro valor: ")
		leia(n1)
		escreva("digite o segundo valor: ")
		leia(n2)
		escreva("digite o terceiro valor: ")
		leia(n3)
		escreva("digite o quarto valor: ")
		leia(n4)

		m=n1

		se(m<n2){
			m=n2
			}
		se(m<n3){
			m=n3
			}
		se(m<n4){
			m=n4
			}
			escreva("Maior: ", m)
	}
}
