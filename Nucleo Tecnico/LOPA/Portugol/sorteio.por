programa
{
	inclua biblioteca Util--> u
	
	funcao inicio()
	{
		inteiro i, mi, ma
		escreva("sorteio minimo: ")
		leia(mi)
		escreva("sorteio maximo: ")
		leia(ma)
	i= u.sorteia(mi, ma)
		escreva("numero sorteado: ",i)

	}
}	
