programa
{
	
	funcao inicio()
	{
		real v,r ,vr
		escreva("valor a ser reajustado: ")
		leia(v)
		escreva("porcentagem de reajuste: ")
		leia(r)
		vr=v+v/100*r
		escreva("valor reajustado: ",vr)
	}
}
