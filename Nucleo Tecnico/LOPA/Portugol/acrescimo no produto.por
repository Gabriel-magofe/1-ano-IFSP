programa
{
	
	funcao inicio()
	{
		real  s, d, p, r

	escreva("valor original do produto: ")
	leia(s)
	escreva("porcentagem de acrescimo: ")
	leia (d)
	p = s/100*d
	r = s+p
	escreva("valor final: ",r)
	}
}
