programa
{
	
	funcao inicio()
	{
		real l1, l2, p, a
		escreva("digite o valor do lado 1: ""\n")
		leia(l1)

		escreva("digite o valor do lado 2: ""\n")
		lei(l2)

		p=l1*2+l1*l2
		a=l1**l2

		escreva("perimetro: ", p, "area: ",a)
	}
}

