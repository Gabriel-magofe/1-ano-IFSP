programa
{
	
	funcao inicio()
	{
		real n1, n2, r
		
		escreva("digite o primeiro valor: ")
		leia(n1)
		escreva("digite o segundo valor: ")
		leia(n2)
		
		r= n1/n2

		se(r<5){escreva("resultado: ", r)}
	}
		
}
