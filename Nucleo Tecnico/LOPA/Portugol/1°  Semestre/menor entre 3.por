programa
{
	
	funcao inicio()
	{
		inteiro n1, n2, n3, m

		escreva("digite o primeiro valor: ")
		leia(n1)
		escreva("digite o segundo valor: ")
		leia(n2)
		escreva("digite o terceiro valor: ")
		leia(n3)

		m=n1

		se(m>n2){
			m=n2
			}
		se(m>n3){
			m=n3
			}
		
			escreva("Menor: ", m)
	}
}
